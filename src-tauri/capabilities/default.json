{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for KING-FUN (desktop + mobile).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.vercel.app/api/**"
        },
        {
          "url": "http://localhost:*/**"
        },
        {
          "url": "http://127.0.0.1:*/**"
        },
        {
          "url": "http://[::1]:*/**"
        }
      ]
    }
  ]
}
