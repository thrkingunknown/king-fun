ght:1.5}.ui-status-action{display:inline-flex;align-items:center;gap:6px;border:0;background:none;color:var(--kf-accent);font-size:10px;font-weight:800}.ui-prompt-card{padding:clamp(18px,3vw,30px);border:1px solid var(--kf-line);border-radius:20px;background:linear-gradient(145deg,var(--kf-panel),var(--kf-panel-2));box-shadow:var(--kf-shadow)}.ui-prompt-content{margin:18px 0;font-size:clamp(19px,2.5vw,28px);font-weight:800;line-height:1.35;letter-spacing:-.03em}.ui-prompt-footer{display:flex;flex-wrap:wrap;gap:9px;padding-top:12px;border-top:1px solid var(--kf-line)}.ui-progress-track{height:7px;overflow:hidden;border-radius:99px;background:var(--kf-panel-3)}.ui-progress-fill{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--kf-accent),#8bd9e8);transition:width .25s}.ui-choice-button{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:48px;padding:10px 14px;border:1px solid var(--kf-line);border-radius:12px;background:var(--kf-panel-2);color:var(--kf-text);font-size:12px;font-weight:750}.ui-choice-button:hover{border-color:var(--kf-accent)}.ui-choice-icon{color:var(--kf-accent)}.kf-dialog{width:min(480px,calc(100vw - 28px));margin:auto}.kf-dialog-icon{display:grid;place-items:center;width:42px;height:42px;margin-bottom:13px;border:1px solid var(--kf-line);border-radius:13px;background:var(--kf-panel-2);color:var(--kf-accent)}.kf-dialog-icon.is-danger{color:#ff8e98;background:#ed66731a}.kf-dialog-heading h2{margin:7px 0;font-size:20px;letter-spacing:-.04em}.ui-confirm-dialog>p{color:var(--kf-muted);font-size:12px;line-height:1.65}.ui-dialog-actions{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:8px;margin-top:20px}.report-dialog{display:grid;gap:12px;width:min(720px,calc(100vw - 28px));max-width:calc(100vw - 28px);scrollbar-gutter:stable}.report-dialog h2{margin:0;font-size:19px}.report-reasons{display:grid;gap:8px}.report-reasons label{display:flex;align-items:center;gap:9px;padding:10px;border:1px solid var(--kf-line);border-radius:10px;background:var(--kf-panel-2);font-size:11px}.report-note-label{display:grid;gap:7px;color:var(--kf-muted);font-size:10px}.report-note-label textarea{width:100%;min-height:90px;padding:10px;border:1px solid var(--kf-line);border-radius:10px;background:var(--kf-panel-2);color:var(--kf-text)}.reaction-bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:12px;border:1px solid var(--kf-line);border-radius:12px;background:var(--kf-panel-2)}.reaction-title{color:var(--kf-subtle);font:800 8px ui-monospace,monospace;letter-spacing:.12em}.reaction-actions{display:flex;gap:6px}.reaction-actions button{display:grid;place-items:center;width:36px;height:36px;border:1px solid var(--kf-line);border-radius:10px;background:var(--kf-panel);color:var(--kf-muted)}.reaction-actions button.is-selected{border-color:var(--kf-accent);background:color-mix(in srgb,var(--kf-accent),transparent 88%);color:var(--kf-accent)}.reaction-bar small{margin-left:auto;color:var(--kf-subtle);font-size:9px}\n.app.light .hero-v2{background:radial-gradient(ellipse at 78% 40%,#41597699,transparent 35%),linear-gradient(130deg,#172332,#17212c 56%,#22313b)}.app.light .game-card-v2 .game-card-bottom h3{color:#f6f8fc}.app.light .game-card-v2 .game-card-bottom p{color:#b8c3cf}.app.light .setup-aside{box-shadow:0 16px 40px #1a29360e}.app.light .app-footer{border-color:var(--kf-line)}\n@media(max-width:1100px){.game-card-v2{grid-column:span 6;min-height:320px}.ai-provider-row,.kf-provider-row{grid-template-columns:28px 26px minmax(100px,1fr) auto}.provider-actions{grid-column:3/5}.provider-toggle{grid-column:4;grid-row:1}.ai-provider-row.pinned,.kf-provider-pinned{grid-template-columns:28px 26px minmax(100px,1fr) auto}.kf-provider-pinned .provider-pinned-label{grid-column:3/-1}.promise-intro{grid-column:span 12}.promise-item{grid-column:span 3}}\n@media(max-width:800px){.setup-layout{grid-template-columns:repeat(12,minmax(0,1fr))}.setup-main-column{grid-column:span 12}.setup-aside{grid-column:span 12}.topbar{padding-inline:14px}.topbar-inner{gap:12px}.hero-grid{row-gap:10px}.hero-copy{grid-column:span 7}.hero-art{grid-column:span 5}.hero h1{font-size:clamp(46px,8vw,68px)}.hero-metrics{margin-top:28px}.game-section-v2{padding-inline:18px}.game-card-v2{grid-column:span 6}.setup-aside{position:static;min-height:0}.setup-aside .aside-icon{margin-bottom:16px}.setup-aside-summary{margin-top:8px}.setup-mobile-action{display:none}.settings-grid .setting-card{grid-column:span 12}.workspace-heading{align-items:flex-start}.history-summary-card{min-width:130px}.home-promise{padding:20px}}\n@media(max-width:620px){.topbar{min-height:64px}.topbar-inner{min-height:63px}.brand-logo-wrap{width:36px;height:36px;border-radius:11px}.brand-logo{width:26px;height:26px}.brand small{font-size:7px}.brand-name{font-size:13px}.primary-nav{gap:2px;padding:3px;border-radius:13px}.primary-nav-link{width:36px;min-height:36px;padding:0;gap:0;font-size:10px}.primary-nav-link>span:not(.nav-count){display:none}.primary-nav-link svg{width:15px;height:15px}.theme-toggle{width:46px;height:36px}.theme-toggle-track{width:36px;height:28px;padding:0 6px}.theme-toggle-track:before{top:3px;left:3px;width:22px;height:22px}.app.light .theme-toggle-track:before{transform:translateX(8px)}.hero-v2{padding:42px 18px 20px}.hero-copy{grid-column:span 12}.hero-art{grid-column:span 12;grid-row:2}.hero h1{font-size:clamp(46px,12vw,68px)}.hero-description{max-width:440px}.hero-metrics{gap:24px;margin-top:28px}.hero-metrics strong{font-size:19px}.hero-metrics span{font-size:7px}.hero-bottomline{font-size:7px;letter-spacing:.08em}.hero-bottomline span:first-child{display:none}.hero-bottomline span:last-child{margin-left:auto}.resume-banner-v2{width:calc(100% - 28px);padding:12px}.resume-copy b{font-size:12px}.resume-arrow{font-size:8px}.game-section-v2{padding:40px 14px}.section-heading-v2{align-items:flex-start}.section-heading-v2 .library-status{display:none}.section-heading h2{font-size:29px}.game-grid-v2{gap:9px}.game-card-v2{grid-column:span 6;min-height:282px;padding:12px;border-radius:14px}.game-card-v2 .card-art{inset:58px 0 60px}.game-card-v2 .art-shape{width:112px;height:112px}.game-card-v2 .shape-b{width:86px;height:86px}.game-card-v2 .art-word{font-size:37px}.game-card-bottom h3{font-size:16px}.game-card-bottom p{font-size:9px}.game-card-meta{font-size:7px}.game-card-meta span:last-child{display:none}.home-promise{grid-template-columns:repeat(12,minmax(0,1fr));width:calc(100% - 28px);padding:16px;margin-bottom:38px}.promise-intro{grid-column:span 12}.promise-item{grid-column:span 6}.kf-workspace{padding:24px 14px 72px}.workspace-topline{margin-bottom:20px}.workspace-heading{gap:15px}.page-title{font-size:clamp(38px,10vw,54px)}.history-summary-card{min-width:105px;padding:12px}.history-summary-card strong{font-size:25px}.history-summary-card small{font-size:7px}.history-row-v2{gap:10px;padding:12px}.history-game-mark{width:34px;height:34px}.history-entry-title strong{font-size:11px}.history-row-arrow{display:none}.setup-layout{gap:14px}.setup-main-column{gap:12px}.setup-config-card,.player-panel,.setting-card{padding:14px;border-radius:14px}.setup-layout .mode-grid{grid-template-columns:1fr}.mode-card{min-height:0;display:grid;grid-template-columns:32px 1fr;gap:4px 10px}.mode-card-icon{grid-row:span 2}.mode-card small{grid-column:2}.kf-player-form{align-items:stretch}.kf-player-form input{min-width:0}.kf-player-form .kf-btn{flex:none}.ai-provider-row,.kf-provider-row,.ai-provider-row.pinned,.kf-provider-pinned{grid-template-columns:26px 24px minmax(0,1fr) auto;gap:7px;padding:9px}.provider-actions{grid-column:1/-1;grid-row:auto}.provider-toggle{grid-column:4;grid-row:1}.provider-actions .setting-action{min-height:32px;padding:0 8px}.provider-pinned-label{grid-column:3/-1}.pack-choice{align-items:flex-start}.pack-manage{flex-direction:column}.history-toolbar{margin-top:30px}.app-footer{padding-inline:14px}}\n@media(max-width:390px){.brand small{display:none}.brand{gap:7px}.brand-logo-wrap{width:32px;height:32px}.brand-name{font-size:12px}.primary-nav-link{padding:0 7px}.primary-nav-link span{font-size:9px}.topbar-actions{gap:6px}.game-card-v2{min-height:260px}.game-card-meta{display:none}.hero-actions{gap:13px}.hero-reassurance{font-size:10px}.kf-player-form{flex-direction:column}.kf-player-form .kf-btn{width:100%}}\n@media(prefers-reduced-motion:reduce){.app,.kf-btn,.game-card-v2,.history-row-v2,.kf-switch-thumb,.kf-switch-track{transition:none!important}.game-card-v2:hover,.history-row-v2:hover{transform:none}}\n\n/* Enhanced touch target baseline: keep interactive controls comfortable on phones. */\n.app :where(button,a){min-height:44px}\n\n.command-trigger{display:inline-flex;align-items:center;gap:7px;min-height:38px;padding:0 9px;border:1px solid var(--kf-line);border-radius:10px;background:var(--kf-panel);color:var(--kf-muted)}.command-trigger:hover{border-color:var(--kf-accent);color:var(--kf-text)}.command-trigger kbd,.command-search kbd,.command-footer kbd,.command-palette kbd{padding:3px 5px;border:1px solid var(--kf-line);border-radius:5px;background:var(--kf-panel-2);color:var(--kf-subtle);font:800 8px ui-monospace,monospace;letter-spacing:.04em}.command-palette{position:fixed;inset:0;width:min(620px,calc(100vw - 28px));max-height:min(680px,calc(100dvh - 42px));margin:auto;padding:0;overflow:hidden;border:1px solid var(--kf-line);border-radius:20px;background:var(--kf-panel);color:var(--kf-text);box-shadow:0 35px 120px #0009}.command-palette::backdrop{background:#05080dbd;backdrop-filter:blur(10px)}.command-palette [cmdk-root]{display:flex;flex-direction:column;max-height:min(680px,calc(100dvh - 42px))}.command-search{display:flex;align-items:center;gap:11px;padding:16px;border-bottom:1px solid var(--kf-line);color:var(--kf-muted)}.command-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--kf-text);font-size:14px}.command-search input::placeholder{color:var(--kf-subtle)}.command-palette [cmdk-list]{max-height:440px;overflow:auto;padding:8px}.command-palette [cmdk-group-heading]{padding:10px 9px 6px;color:var(--kf-subtle);font:800 8px ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}.command-palette [cmdk-item]{display:flex;align-items:center;gap:10px;min-height:42px;padding:9px 11px;border:1px solid transparent;border-radius:10px;color:var(--kf-text);font-size:11px;cursor:pointer}.command-palette [cmdk-item] svg{color:var(--kf-accent)}.command-palette [cmdk-item][aria-selected=true]{border-color:color-mix(in srgb,var(--kf-accent),transparent 70%);background:color-mix(in srgb,var(--kf-accent),var(--kf-panel) 93%)}.command-palette [cmdk-item] small{margin-left:auto;color:var(--kf-subtle);font-size:9px}.command-palette [cmdk-empty]{padding:28px;text-align:center;color:var(--kf-muted);font-size:11px}.command-palette [cmdk-separator]{height:1px;margin:7px 8px;background:var(--kf-line)}.command-footer{display:flex;flex-wrap:wrap;gap:13px;padding:11px 15px;border-top:1px solid var(--kf-line);color:var(--kf-subtle);font-size:9px}.command-footer span{display:inline-flex;align-items:center;gap:5px}\n@media(max-width:620px){.command-trigger{width:36px;min-height:36px;justify-content:center;padding:0}.command-trigger kbd{display:none}}\n\n/* Utility surface aliases and responsive form controls. */\n.workspace{width:min(1440px,100%);margin-inline:auto;padding:clamp(26px,4vw,54px) clamp(16px,4.5vw,68px) 84px}\n.team-name-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}\n.team-name-fields label,.duration-setting{display:grid;gap:7px;color:var(--kf-muted);font-size:10px;font-weight:750}\n.assignment-heading{margin-top:16px}\n.assignment-list{display:grid;gap:7px;margin-bottom:12px}\n.assignment-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 10px;border:1px solid var(--kf-line);border-radius:10px;background:var(--kf-panel-2);color:var(--kf-text);font-size:11px}\n.assignment-row select{width:min(190px,55%);min-height:36px;padding:6px 9px;border:1px solid var(--kf-line);border-radius:8px;background:var(--kf-panel);color:var(--kf-text);font-size:10px}\n.duration-setting{margin:10px 0}\n.guess-preferences{display:grid;gap:0;margin-top:8px;padding:10px 12px;border:1px solid var(--kf-line);border-radius:12px;background:var(--kf-panel-2)}\n.response-methods{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}\n.response-method{display:grid;align-content:start;gap:8px;min-height:92px;padding:13px;border:1px solid var(--kf-line);border-radius:12px;background:var(--kf-panel-2);color:var(--kf-text);text-align:left}\n.response-method strong{font-size:11px}\n.response-method small{color:var(--kf-muted);font-size:9px;line-height:1.5}\n.response-method.is-selected{border-color:var(--kf-accent);background:color-mix(in srgb,var(--kf-accent),var(--kf-panel) 93%);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--kf-accent),transparent 72%)}\n.small-text-button{min-height:32px;padding:0 8px;font-size:9px}\n.setup-workspace>.back-link{margin-bottom:18px}\n.settings-workspace>.page-title{margin-bottom:22px}\n.setting-card .setting-field{margin-top:8px}\n.setting-card .text-button{min-height:30px}\n.provider-drag-handle:focus-visible,.provider-order-button:focus-visible,.setting-action:focus-visible{outline:2px solid var(--kf-accent);outline-offset:3px}\n.provider-drag-handle:active{cursor:grabbing}\n.kf-provider-row[aria-roledescription=\"sortable provider\"]{touch-action:pan-y}\n\n\n.kf-switch:focus-visible{outline:2px solid var(--kf-accent);outline-offset:3px}\n.ui-progress{width:100%}\n.ui-progress-track{position:relative;width:100%}\n.ui-progress-fill{min-width:0}\n.ui-choice-button:focus-visible,.response-method:focus-visible,.mode-card:focus-visible{outline:2px solid var(--kf-accent);outline-offset:3px}\n.pack-select:focus-visible{outline:2px solid var(--kf-accent);outline-offset:2px}\n@media(max-width:620px){.team-name-fields,.response-methods{grid-template-columns:1fr}.assignment-row{align-items:flex-start;flex-direction:column}.assignment-row select{width:100%}.workspace{padding-inline:14px;padding-top:24px}}\n\n.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}\n@media(max-width:620px){.primary-nav-link>span:not(.nav-count){display:block!important;position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}}\n\n\n/* Keep dense settings controls inside their grid track at desktop and tablet widths. */\n.settings-grid,.settings-grid>.setting-card,.ai-provider-card,.ai-provider-list,.ai-provider-row,.kf-provider-row,.ai-generate-tools,.ai-generate-fields{min-width:0;max-width:100%;}\n.ai-provider-row,.kf-provider-row{grid-template-columns:30px 27px minmax(0,1fr) minmax(0,auto) auto;}\n.provider-identity,.provider-actions{min-width:0;}\n.provider-identity strong,.provider-connection,.provider-pinned-label{min-width:0;overflow-wrap:anywhere;}\n.provider-connection{flex-wrap:wrap;}\n.provider-actions{display:flex;flex-wrap:wrap;gap:6px;}\n.storage-state{min-width:0;flex-wrap:wrap;}\n.storage-state>span:nth-child(2){flex:1 1 180px;min-width:0;overflow-wrap:anywhere;}\n.ai-generate-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;}\n.ai-generate-fields label{min-width:0;}\n.ai-generate-fields input,.ai-generate-fields select{max-width:100%;}\n@media(max-width:1100px){.settings-grid>.setting-card{grid-column:span 12;}.ai-provider-row,.kf-provider-row{grid-template-columns:28px 26px minmax(0,1fr) auto;}.ai-provider-row .provider-actions,.kf-provider-row .provider-actions{grid-column:3/-1;}.ai-provider-row .provider-toggle,.kf-provider-row .provider-toggle{grid-column:4;grid-row:1;}.ai-provider-row.pinned,.kf-provider-row.kf-provider-pinned{grid-template-columns:28px 26px minmax(0,1fr) auto;}.kf-provider-pinned .provider-pinned-label{grid-column:3/-1;}}\n@media(max-width:620px){.ai-generate-fields{grid-template-columns:minmax(0,1fr);}.ai-provider-row,.kf-provider-row,.ai-provider-row.pinned,.kf-provider-pinned{grid-template-columns:26px 24px minmax(0,1fr) auto;}.provider-actions{grid-column:1/-1!important;grid-row:auto!important;}.provider-toggle{grid-column:4;grid-row:1;}.kf-provider-pinned .provider-pinned-label{grid-column:3/-1;}}\n\n/* Keep native dialogs out of layout until opened in the top layer. */\n.app dialog:not([open]){display:none}\n\n/* Explicit light-theme mode surfaces. These retain the shared semantic tokens\n   while ensuring selection and hover remain legible on bright backgrounds. */\n.app.light .mode-card {\n  border-color: var(--kf-line);\n  background: var(--kf-panel-2);\n  color: var(--kf-text);\n}\n.app.light .mode-card:hover {\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 42%);\n  background: var(--kf-panel);\n}\n.app.light .mode-card.is-selected {\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 30%);\n  background: color-mix(in srgb, var(--kf-accent), var(--kf-panel) 93%);\n  color: var(--kf-text);\n}\n\n/* CSS-owned sortable transition avoids ref-derived transition reads in render. */\n.kf-provider-row{transition:transform 200ms cubic-bezier(.2,0,0,1)}\n.kf-provider-row.is-dragging{transition:none}\n\n\n/* Motion is CSS-owned so the home entry does not download a JS animation runtime. */\n.screen-transition:not(.motion-reduced){animation:kf-screen-enter 180ms ease-out both;}\n.game-card-v2{animation:kf-card-enter 340ms cubic-bezier(.2,.75,.25,1) both;}\n.history-row-v2{animation:kf-card-enter 220ms ease-out both;}\n@keyframes kf-screen-enter{from{transform:translateY(8px)}to{transform:translateY(0)}}\n@keyframes kf-card-enter{from{transform:translateY(10px)}to{transform:translateY(0)}}\n\n/* Keep the complete top navigation within very narrow phone viewports. */\n@media(max-width:390px){\n  .topbar{padding-inline:8px;}\n  .topbar-inner{gap:6px;}\n  .brand{gap:5px;flex:0 1 auto;min-width:0;}\n  .brand-logo-wrap{width:30px;height:30px;}\n  .brand-logo{width:24px;height:24px;}\n  .brand-name{font-size:11px;letter-spacing:.04em;}\n  .primary-nav{flex:0 0 auto;gap:1px;padding:2px;}\n  .primary-nav-link{width:30px;min-width:30px;flex:0 0 30px;padding:0;}\n  .topbar-actions{flex:0 0 auto;gap:4px;}\n  .command-trigger{width:30px;min-width:30px;padding:0;justify-content:center;}\n  .command-trigger kbd{display:none;}\n  .theme-toggle{width:38px;min-width:38px;padding:2px;}\n  .theme-toggle-track{width:32px;}\n}\n@media(prefers-reduced-motion:reduce){\n  .screen-transition:not(.motion-reduced),.game-card-v2,.history-row-v2{animation:none!important;}\n}\n\n\n/* A narrow decoration or transform must never widen the layout viewport. */\nhtml,body,#root{width:100%;max-width:100%;min-width:0;overflow-x:clip;}\n#root,.app{max-width:100%;}\n@media(max-width:620px){\n  .app-footer{flex-wrap:wrap;justify-content:center;gap:8px 14px;text-align:center;}\n  .app-footer>span:last-child{flex-basis:100%;}\n  .hero-bottomline{flex-wrap:wrap;}\n  .hero-bottomline span:last-child{max-width:100%;white-space:normal;text-align:center;}\n}\n\n.kf-toast-viewport{position:fixed;z-index:80;top:calc(78px + env(safe-area-inset-top));right:max(14px,env(safe-area-inset-right));width:min(420px,calc(100vw - 28px));pointer-events:none;}\n.kf-toast{display:flex;align-items:flex-start;gap:12px;padding:13px 14px;border:1px solid var(--kf-line);border-radius:14px;background:var(--kf-panel);color:var(--kf-text);box-shadow:0 16px 46px #0005;font-size:12px;line-height:1.55;pointer-events:auto;animation:kf-toast-enter 160ms ease-out both;}\n.kf-toast>span{min-width:0;flex:1;overflow-wrap:anywhere;}\n.kf-toast>button{display:grid;place-items:center;width:28px;min-height:28px;flex:none;border:1px solid var(--kf-line);border-radius:8px;background:var(--kf-panel-2);color:var(--kf-muted);}\n@keyframes kf-toast-enter{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}\n@media(prefers-reduced-motion:reduce){.kf-toast{animation:none;}}\n\n\n\n/* Authoritative provider layout: names are first-class visible content, not a\n   secondary label that can collapse when actions or switches wrap. */\n.ai-provider-stack{display:grid;grid-template-columns:minmax(0,1fr);gap:9px;width:100%;min-width:0;}\n.kf-provider-list{display:grid;grid-template-columns:minmax(0,1fr);gap:9px;width:100%;min-width:0;}\n.kf-provider-row:not(.kf-provider-pinned){display:grid;grid-template-columns:28px 26px minmax(0,1fr) 72px;grid-template-rows:auto auto;grid-template-areas:\"drag rank identity toggle\" \"actions actions actions actions\";align-items:center;gap:8px;min-width:0;min-height:82px;height:auto;padding:10px;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-drag-handle{grid-area:drag;}\n.kf-provider-row:not(.kf-provider-pinned)>.ai-provider-rank{grid-area:rank;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-identity{grid-area:identity;display:grid!important;grid-template-columns:minmax(0,1fr);align-content:center;align-self:stretch;width:100%;min-width:0;min-height:38px;visibility:visible!important;opacity:1!important;}\n.kf-provider-row:not(.kf-provider-pinned) .provider-name{display:block!important;position:static!important;width:100%;min-width:0;max-width:100%;height:auto;overflow:visible;clip:auto;clip-path:none;transform:none;visibility:visible!important;opacity:1!important;color:var(--kf-text)!important;font-size:12px;font-weight:800;line-height:1.35;white-space:normal;overflow-wrap:anywhere;}\n.kf-provider-row:not(.kf-provider-pinned) .provider-connection{display:flex;min-width:0;max-width:100%;visibility:visible!important;opacity:1!important;overflow-wrap:anywhere;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-toggle{grid-area:toggle;justify-self:end;display:flex;align-items:center;justify-content:space-between;gap:4px;width:72px;min-width:72px;min-height:44px;padding:3px 5px;opacity:1;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-toggle:disabled{opacity:1;cursor:not-allowed;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-toggle .kf-switch-state{min-width:18px;color:var(--kf-text);font-size:8px;letter-spacing:.04em;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-toggle .kf-switch-track{width:30px;height:20px;padding:3px;flex:none;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-toggle .kf-switch-thumb{width:14px;height:14px;}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-toggle.is-on .kf-switch-thumb{transform:translateX(10px);}\n.kf-provider-row:not(.kf-provider-pinned)>.provider-actions{grid-area:actions;display:flex;align-items:center;flex-wrap:wrap;gap:6px;min-width:0;}\n.kf-provider-pinned{display:grid;grid-template-columns:28px 26px minmax(0,1fr) auto;grid-template-rows:auto auto;grid-template-areas:\"lock rank identity test\" \"lock rank server server\";align-items:center;gap:8px;min-width:0;}\n.kf-provider-pinned>.provider-pinned-icon{grid-area:lock;}\n.kf-provider-pinned>.ai-provider-rank{grid-area:rank;}\n.kf-provider-pinned>.provider-identity{grid-area:identity;display:grid;grid-template-columns:minmax(0,1fr);min-width:0;}\n.kf-provider-pinned .provider-name{display:block;min-width:0;overflow-wrap:anywhere;color:var(--kf-text);font-size:12px;font-weight:800;line-height:1.35;}\n.kf-provider-pinned>.provider-pinned-test{grid-area:test;}\n.kf-provider-pinned>.provider-pinned-label{grid-area:server;justify-self:start;min-width:0;}\n@media(max-width:620px){\n  .kf-provider-row:not(.kf-provider-pinned){grid-template-columns:24px 24px minmax(0,1fr) 72px;gap:7px;padding:9px;}\n  .kf-provider-row:not(.kf-provider-pinned)>.provider-actions{gap:5px;}\n  .kf-provider-row:not(.kf-provider-pinned) .provider-actions .setting-action{min-height:32px;padding-inline:8px;}\n  .kf-provider-pinned{grid-template-columns:24px 24px minmax(0,1fr);grid-template-areas:\"lock rank identity\" \"lock rank test\" \"lock rank server\";}\n}\n\n/* Stable, opaque text colours keep home-hero contrast independent of theme\n   transitions and lazy feature stylesheet insertion order. */\n.app:not(.light) .hero-primary-action{background:#c6f36b!important;color:#18210d!important;opacity:1!important;}\n.app.light .hero-primary-action{background:#4f7020!important;color:#fff!important;opacity:1!important;}\n/* Theme changes must not tween foreground/background through failing contrast ratios. */\n.app .hero-primary-action{transition:transform .16s,box-shadow .16s!important;}\n.app .hero-art .chaos-art,.app .hero-art .chaos-token{opacity:1!important;filter:none!important;}\n.app .hero-art .chaos-token small{color:#fff!important;opacity:1!important;text-shadow:0 1px 2px #0008;}\n\n\n/* Header layout hardening: compact controls before the brand and actions compete for space. */\n.topbar,.topbar-inner,.topbar-actions,.primary-nav{min-width:0}\n.topbar-inner>*{flex-shrink:1}\n.brand{flex:0 1 auto}\n.primary-nav,.topbar-actions,.theme-toggle,.command-trigger{flex-shrink:0}\n@media(max-width:800px){.topbar{padding-inline:16px}.topbar-inner{gap:clamp(8px,2vw,14px)}.topbar-actions{gap:8px}}\n@media(max-width:620px){\n .topbar{padding-inline:12px}.topbar-inner{min-height:60px;gap:8px}.brand{gap:7px}.brand small{display:none}.brand-name{font-size:12px;letter-spacing:.07em}.brand-logo-wrap{width:34px;height:34px}.brand-logo{width:25px;height:25px}\n .primary-nav{gap:2px;padding:3px}.primary-nav-link{width:36px;min-width:36px;min-height:36px;padding:0}\n .primary-nav-link>span:not(.nav-count){display:block!important;position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}\n .topbar-actions{gap:6px}.command-trigger{width:36px;min-width:36px;min-height:36px;padding:0;justify-content:center}.command-trigger kbd{display:none}\n .theme-toggle{width:44px;height:36px}.theme-toggle-track{width:34px;height:28px}.theme-toggle-track:before{top:3px;left:3px;width:22px;height:22px}.theme-toggle-track svg{top:6px;left:6px}.app.light .theme-toggle-track:before{transform:translateX(8px)}.app.light .theme-toggle-track svg{left:14px}\n}\n@media(max-width:360px){.topbar{padding-inline:8px}.topbar-inner{gap:5px}.brand-name{font-size:11px}.brand-logo-wrap{width:30px;height:30px}.primary-nav-link,.command-trigger{width:32px;min-width:32px}.theme-toggle{width:40px}}\n\n/* Prevent intrinsic content widths from distorting the hero's 7/5 grid. */\n.hero-grid,.hero-copy,.hero-art{min-width:0}.hero-copy{grid-column:span 7}.hero-art{grid-column:span 5}.hero-grid{max-width:1280px}\n@media(max-width:900px) and (min-width:621px){.hero-v2{padding-inline:clamp(20px,3vw,40px)}.hero h1{font-size:clamp(42px,6.4vw,62px)}.hero-description{font-size:14px}}\n@media(max-width:620px){.hero-copy,.hero-art{grid-column:span 12}.hero-art{grid-row:2}}\n\n/* Local party arcade ------------------------------------------------------ */\n.party-stage{width:min(100%,920px);margin:0 auto;padding:clamp(20px,4vw,44px) clamp(14px,3vw,28px);display:grid;gap:24px}\n.party-stage-heading{max-width:760px;display:grid;gap:10px}\n.party-stage-heading .eyebrow{color:var(--kf-accent,#b8f36a);font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}\n.party-stage-heading h1{margin:0;font-size:clamp(30px,5vw,52px);line-height:1.02;letter-spacing:-.045em;text-wrap:balance}\n.party-stage-heading p{max-width:650px;margin:0;color:var(--kf-text-muted,#89939e);font-size:clamp(14px,2vw,17px);line-height:1.6}\n.party-stage-content{display:grid;gap:16px;min-width:0}\n.party-card{min-width:0;display:grid;gap:16px;padding:clamp(18px,3vw,28px);border:1px solid var(--kf-border,rgba(255,255,255,.12));border-radius:22px;background:var(--kf-panel,#171c22);box-shadow:0 14px 40px rgba(0,0,0,.12)}\n.party-card-accent{border-color:color-mix(in srgb,var(--kf-accent,#b8f36a) 34%,var(--kf-border,transparent));background:linear-gradient(145deg,color-mix(in srgb,var(--kf-accent,#b8f36a) 7%,var(--kf-panel,#171c22)),var(--kf-panel,#171c22) 60%)}\n.party-card-warning{border-color:rgba(255,177,90,.35);background:linear-gradient(145deg,rgba(255,177,90,.08),var(--kf-panel,#171c22) 60%)}\n.party-card h2{margin:0;font-size:clamp(22px,3.2vw,34px);line-height:1.14;letter-spacing:-.025em;text-wrap:balance}\n.party-card p{margin:0;color:var(--kf-text-muted,#9ba4ae);line-height:1.55}\n.party-card-label,.party-progress-note{margin:0;color:var(--kf-text-muted,#89939e);font:700 10px/1.4 var(--font-mono,ui-monospace,monospace);letter-spacing:.13em;text-transform:uppercase}\n.party-help{font-size:13px;color:var(--kf-text-muted,#89939e);line-height:1.55}\n.party-actions{display:flex;align-items:stretch;gap:10px;flex-wrap:wrap}\n.party-button{min-height:46px;padding:12px 17px;border:1px solid transparent;border-radius:13px;font-family:inherit;font-size:14px;font-weight:700;line-height:1.2;cursor:pointer;transition:transform .16s ease,background .16s ease,border-color .16s ease;touch-action:manipulation}\n.party-button:hover:not(:disabled){transform:translateY(-1px)}.party-button:focus-visible,.party-option:focus-visible,.party-build-choice:focus-visible{outline:3px solid color-mix(in srgb,var(--kf-accent,#b8f36a) 68%,white);outline-offset:3px}\n.party-button:disabled{opacity:.48;cursor:not-allowed}\n.party-button-primary{background:var(--kf-accent,#b8f36a);color:#13180e}\n.party-button-secondary{background:var(--kf-control,#252c34);color:var(--kf-text,#f2f4f6);border-color:var(--kf-border,rgba(255,255,255,.12))}\n.party-button-quiet{background:transparent;color:var(--kf-text-muted,#9ba4ae);border-color:var(--kf-border,rgba(255,255,255,.12))}\n.party-button-danger{background:#a53b3b;color:white}\n.party-player{display:inline-flex;align-items:center;gap:8px;padding:7px 11px;border:1px solid var(--kf-border,rgba(255,255,255,.12));border-radius:999px;color:var(--kf-text,#f2f4f6);font-size:13px}\n.party-player>span{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--kf-control,#252c34);font-size:11px;font-weight:800}\n.party-player.is-active{border-color:var(--kf-accent,#b8f36a)}.party-player.is-subdued{opacity:.5}\n.party-metric{min-width:110px;display:grid;gap:5px;padding:12px 14px;border:1px solid var(--kf-border,rgba(255,255,255,.1));border-radius:12px}\n.party-metric span{color:var(--kf-text-muted,#89939e);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}\n.party-metric strong{font-size:21px;letter-spacing:-.04em;font-variant-numeric:tabular-nums}\n.party-choice-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:9px}\n.party-choice-grid button,.party-option{min-width:0;min-height:48px;padding:12px 14px;border:1px solid var(--kf-border,rgba(255,255,255,.14));border-radius:12px;background:var(--kf-control,#252c34);color:var(--kf-text,#f2f4f6);text-align:left;font-family:inherit;font-size:14px;font-weight:600;line-height:1.35;cursor:pointer}\n.party-choice-grid button.is-selected,.party-option.is-selected{border-color:var(--kf-accent,#b8f36a);background:color-mix(in srgb,var(--kf-accent,#b8f36a) 13%,var(--kf-control,#252c34))}\n.party-option-list{display:grid;gap:9px}.party-option{display:flex;align-items:center;gap:12px}.party-option>span{flex:0 0 28px;display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:rgba(128,128,128,.18);font:800 12px/1 var(--font-mono,monospace)}\n.party-field-label{display:grid;gap:7px;color:var(--kf-text-muted,#9ba4ae);font-size:12px;font-weight:750}\n.party-input{width:100%;min-height:48px;padding:12px 14px;border:1px solid var(--kf-border,rgba(255,255,255,.16));border-radius:12px;background:var(--kf-control,#252c34);color:var(--kf-text,#f2f4f6);font-family:inherit;font-size:16px;font-weight:500;line-height:1.3}\n.party-input:focus-visible{outline:2px solid var(--kf-accent,#b8f36a);outline-offset:2px}\n.party-inline-error{color:#ff9b8d!important;font-size:12px!important}\n.party-notice{padding:10px 12px;border-radius:10px;background:rgba(128,128,128,.12);font-size:13px}\n.party-result-row,.party-result-list>div,.party-budget-grid>div{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--kf-border,rgba(255,255,255,.1));font-size:13px}\n.party-result-row strong,.party-result-list strong,.party-budget-grid strong{font-variant-numeric:tabular-nums}\n.party-budget-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:0 16px}\n.party-build-card{display:grid;gap:7px;padding:14px 0;border-bottom:1px solid var(--kf-border,rgba(255,255,255,.1))}\n.party-build-choice{display:flex;justify-content:space-between;gap:12px;align-items:center;border:0;background:none;color:inherit;text-align:left;cursor:pointer}\n.party-build-choice span,.party-build-card p{color:var(--kf-text-muted,#9ba4ae);font-size:12px}\n.party-build-card p{margin:0;padding-left:8px}\n.party-clock,.hot-bomb-timer,.tilt-clock,.reverse-recording-time{font-size:clamp(48px,9vw,88px);font-weight:800;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.06em}\n.party-clock small,.hot-bomb-timer small,.tilt-clock small,.reverse-recording-time small{margin-left:6px;font-size:14px;letter-spacing:.08em}\n.hot-bomb-timer,.tilt-clock{display:flex;align-items:baseline;justify-content:center;color:var(--kf-accent,#b8f36a)}\n.hot-bomb-card{max-width:680px;margin-inline:auto;text-align:center}\n.hot-bomb-card .party-field-label{text-align:left}\n.hot-bomb-card .party-input{text-align:center}\n.tilt-word,.identity-card{text-align:center;font-size:clamp(38px,8vw,76px)!important;letter-spacing:-.05em!important;padding:24px 10px}\n.tilt-progress{height:5px;overflow:hidden;border-radius:999px;background:var(--kf-control,#252c34)}.tilt-progress span{display:block;height:100%;background:var(--kf-accent,#b8f36a);transition:width .2s}\n.party-motion-control{display:grid;gap:5px;text-align:center}.party-motion-control button{justify-self:center;border:0;background:transparent;color:var(--kf-accent,#b8f36a);font-weight:750;padding:9px}.party-motion-control span{font-size:11px;color:var(--kf-text-muted,#89939e)}\n.tangle-letters{font-family:var(--font-mono,monospace);letter-spacing:.13em!important;overflow-wrap:anywhere}\n.reverse-recording-time{display:flex;justify-content:center;align-items:baseline}\n@media(max-width:520px){.party-stage{padding-inline:12px;gap:18px}.party-card{border-radius:17px}.party-actions>*{flex:1 1 120px}.party-button{width:100%}.party-build-choice{align-items:flex-start;flex-direction:column}.party-metric{flex:1}}\n@media(prefers-reduced-motion:reduce){.party-button{transition:none}.party-button:hover:not(:disabled){transform:none}.tilt-progress span{transition:none}}\n\n\n/* Ten Tangle: readable ten-card puzzle board, with solved-state contrast and\n   no fixed heights so zoom and longer localized words can reflow naturally. */\n.tangle-puzzle-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.tangle-puzzle{min-width:0;padding:14px;border:1px solid var(--line,rgba(255,255,255,.12));border-radius:14px;background:var(--surface-2,rgba(255,255,255,.035))}\n.tangle-puzzle.is-solved{border-color:var(--accent, #b8ef62);background:color-mix(in srgb,var(--accent, #b8ef62) 8%,transparent)}\n.tangle-puzzle .tangle-letters{font-size:clamp(18px,2vw,26px);letter-spacing:.12em;overflow-wrap:anywhere}\n.tangle-puzzle .party-input{min-width:0}\n@media(max-width:520px){.tangle-puzzle-grid{grid-template-columns:minmax(0,1fr)}}\n\n.party-loading-bar{height:4px;max-width:260px;overflow:hidden;border-radius:999px;background:var(--kf-control,#252c34)}\n.party-loading-bar span{display:block;width:42%;height:100%;border-radius:inherit;background:var(--kf-accent,#b8f36a);animation:party-loading-slide 1.25s ease-in-out infinite alternate}\n@keyframes party-loading-slide{from{transform:translateX(-35%)}to{transform:translateX(175%)}}\n@media(prefers-reduced-motion:reduce){.party-loading-bar span{animation:none;width:100%}}\n"],["STYLE",{},"/* KING-FUN visual refresh: precise surfaces, calmer hierarchy, reactive ambience. */\n:root {\n  --kf-motion-fast: 150ms;\n  --kf-motion-standard: 220ms;\n  --kf-motion-emphasis: 360ms;\n  --kf-ease: cubic-bezier(.2,.72,.24,1);\n  --kf-focus: 0 0 0 3px color-mix(in srgb, var(--kf-accent), transparent 58%);\n}\n\n.app {\n  position: relative;\n  isolation: isolate;\n  color-scheme: dark;\n  --bg: #090d13;\n  --panel: #101722;\n  --panel2: #151f2b;\n  --text: #edf3f9;\n  --muted: #a4afbd;\n  --line: #263345;\n  --kf-bg: #090d13;\n  --kf-panel: #101722;\n  --kf-panel-2: #151f2b;\n  --kf-panel-3: #1b2735;\n  --kf-text: #edf3f9;\n  --kf-muted: #a4afbd;\n  --kf-subtle: #8b98a8;\n  --kf-line: #263345;\n  --kf-accent: #c5f27b;\n  --kf-accent-ink: #17220f;\n  --kf-shadow: 0 22px 64px rgb(0 0 0 / 28%);\n  background:\n    radial-gradient(ellipse at 80% 8%, rgb(99 139 164 / 10%), transparent 32%),\n    radial-gradient(ellipse at 8% 72%, rgb(132 112 187 / 6%), transparent 36%),\n    var(--bg);\n  transition: background-color 220ms ease, color 220ms ease;\n}\n\n.app.light {\n  color-scheme: light;\n  --bg: #f3f6fa;\n  --panel: #ffffff;\n  --panel2: #f7f9fc;\n  --text: #182334;\n  --muted: #526174;\n  --line: #dce4ed;\n  --kf-bg: #f3f6fa;\n  --kf-panel: #ffffff;\n  --kf-panel-2: #f7f9fc;\n  --kf-panel-3: #e9eef5;\n  --kf-text: #182334;\n  --kf-muted: #526174;\n  --kf-subtle: #5d6b7c;\n  --kf-line: #dce4ed;\n  --kf-accent: #557b20;\n  --kf-accent-ink: #ffffff;\n  --kf-shadow: 0 20px 55px rgb(35 54 78 / 9%);\n  background:\n    radial-gradient(ellipse at 80% 8%, rgb(100 148 177 / 11%), transparent 34%),\n    radial-gradient(ellipse at 8% 72%, rgb(142 127 194 / 6%), transparent 36%),\n    var(--bg);\n}\n\n.ambient-scene {\n  position: fixed;\n  z-index: -1;\n  inset: 0;\n  display: block;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  opacity: .78;\n  mix-blend-mode: screen;\n  contain: strict;\n}\n\n.app.light .ambient-scene {\n  opacity: .48;\n  mix-blend-mode: multiply;\n}\n\n.topbar {\n  border-bottom-color: color-mix(in srgb, var(--kf-line), transparent 12%);\n  background: color-mix(in srgb, var(--kf-bg), transparent 12%);\n  box-shadow: 0 1px 0 rgb(255 255 255 / 2%);\n}\n\n.app.light .topbar {\n  background: color-mix(in srgb, #f7f9fc, transparent 10%);\n  box-shadow: 0 1px 0 rgb(22 38 57 / 3%);\n}\n\n.brand-logo-wrap {\n  border-color: color-mix(in srgb, var(--kf-accent), transparent 56%);\n  border-radius: 13px;\n  background: linear-gradient(145deg, color-mix(in srgb, var(--kf-accent), transparent 82%), color-mix(in srgb, #8bd9e8, transparent 92%));\n  box-shadow: inset 0 1px rgb(255 255 255 / 16%), 0 5px 18px color-mix(in srgb, var(--kf-accent), transparent 92%);\n  transition: border-radius var(--kf-motion-standard) var(--kf-ease), transform var(--kf-motion-standard) var(--kf-ease);\n}\n\n.brand:hover .brand-logo-wrap {\n  transform: scale(1.03);\n  border-radius: 15px;\n}\n\n.primary-nav {\n  gap: 4px;\n  padding: 4px;\n  border-color: color-mix(in srgb, var(--kf-line), transparent 8%);\n  border-radius: 14px;\n  background: color-mix(in srgb, var(--kf-panel), transparent 5%);\n  box-shadow: inset 0 1px rgb(255 255 255 / 3%);\n}\n\n.primary-nav-link {\n  min-height: 40px;\n  border-radius: 10px;\n  transition: color var(--kf-motion-fast), background var(--kf-motion-fast), border-color var(--kf-motion-fast), transform var(--kf-motion-fast);\n}\n\n.primary-nav-link:active { transform: scale(.97); }\n.primary-nav-link.is-active {\n  border-color: color-mix(in srgb, var(--kf-accent), transparent 72%);\n  background: color-mix(in srgb, var(--kf-accent), transparent 90%);\n  color: var(--kf-text);\n  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--kf-accent), transparent 92%);\n}\n\n.primary-nav-link.is-active svg { color: var(--kf-accent); }\n\n.theme-toggle,\n.ambient-toggle {\n  position: relative;\n  display: grid;\n  place-items: center;\n  flex: 0 0 auto;\n  width: 42px;\n  min-width: 42px;\n  height: 42px;\n  min-height: 42px;\n  padding: 0;\n  border: 1px solid var(--kf-line);\n  border-radius: 13px;\n  background: color-mix(in srgb, var(--kf-panel-2), transparent 4%);\n  color: var(--kf-muted);\n  transition: color var(--kf-motion-standard), border-color var(--kf-motion-standard), background var(--kf-motion-standard), transform var(--kf-motion-standard), box-shadow var(--kf-motion-standard);\n}\n\n.theme-toggle:hover,\n.ambient-toggle:hover:not(:disabled) {\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 50%);\n  background: var(--kf-panel-3);\n  color: var(--kf-text);\n  box-shadow: 0 5px 16px rgb(0 0 0 / 12%);\n}\n\n.theme-toggle:active,\n.ambient-toggle:active:not(:disabled) { transform: scale(.94); }\n.theme-toggle:focus-visible,\n.ambient-toggle:focus-visible { outline: none; box-shadow: var(--kf-focus); }\n.ambient-toggle[aria-pressed=\"true\"] { color: var(--kf-accent); }\n.ambient-toggle:disabled { opacity: .45; cursor: not-allowed; }\n\n.theme-toggle-track {\n  display: grid;\n  place-items: center;\n  width: 34px;\n  height: 34px;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--kf-line), transparent 10%);\n  background: color-mix(in srgb, var(--kf-panel-3), transparent 3%);\n  color: var(--kf-accent);\n  box-shadow: inset 0 1px rgb(255 255 255 / 5%);\n}\n\n.theme-toggle-track::before {\n  top: 3px;\n  left: 3px;\n  width: 26px;\n  height: 26px;\n  border: 1px solid color-mix(in srgb, var(--kf-line), transparent 12%);\n  background: var(--kf-panel);\n  box-shadow: 0 2px 8px rgb(0 0 0 / 22%), inset 0 1px rgb(255 255 255 / 18%);\n}\n\n.theme-toggle-track svg {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 15px;\n  height: 15px;\n  transform: translate(-50%, -50%) rotate(-12deg);\n  transition: transform var(--kf-motion-standard), color var(--kf-motion-standard);\n}\n\n.app.light .theme-toggle-track::before { transform: scale(.92); background: color-mix(in srgb, var(--kf-accent), var(--kf-panel) 90%); }\n.app.light .theme-toggle-track svg { left: 50%; transform: translate(-50%, -50%) rotate(12deg); color: #a66e17; }\n\n.hero-v2 {\n  border-bottom-color: color-mix(in srgb, var(--kf-line), transparent 18%);\n  background:\n    radial-gradient(ellipse at 78% 42%, rgb(73 111 132 / 26%), transparent 39%),\n    linear-gradient(130deg, rgb(13 20 29 / 96%), rgb(14 20 29 / 91%) 56%, rgb(20 30 39 / 87%));\n}\n\n.hero h1 {\n  letter-spacing: -.082em;\n  text-wrap: balance;\n}\n\n.hero h1 em { color: #c5f27b; }\n.hero-kicker { color: #d5f49f; }\n.hero-description { color: #b8c4d1; }\n.hero-metrics { gap: clamp(24px, 4.4vw, 58px); }\n.hero-metrics strong { letter-spacing: -.07em; }\n.hero-art { perspective: 1000px; }\n\n.app.light .hero-v2 {\n  background:\n    radial-gradient(ellipse at 78% 42%, rgb(138 177 197 / 27%), transparent 40%),\n    linear-gradient(130deg, rgb(248 250 253 / 96%), rgb(241 246 250 / 93%) 56%, rgb(231 239 245 / 91%));\n}\n\n.app.light .hero h1 { color: #172538; }\n.app.light .hero h1 em { color: #527a1d; }\n.app.light .hero-kicker { color: #4d7020; }\n.app.light .hero-description { color: #506176; }\n.app.light .hero-reassurance { color: #35475b; }\n.app.light .hero-reassurance > svg { color: #527a1d; }\n.app.light .hero-reassurance small { color: #647489; }\n.app.light .hero-metrics strong { color: #1b2b3d; }\n.app.light .hero-metrics span { color: #66788a; }\n\n.kf-btn,\n.setting-action,\n.command-trigger,\n.text-button {\n  transition: transform var(--kf-motion-fast), border-color var(--kf-motion-fast), color var(--kf-motion-fast), background var(--kf-motion-fast), box-shadow var(--kf-motion-fast);\n}\n\n.kf-btn:hover:not(:disabled),\n.setting-action:hover:not(:disabled) { transform: translateY(-1px); }\n.kf-btn:focus-visible,\n.setting-action:focus-visible,\n.command-trigger:focus-visible { outline: none; box-shadow: var(--kf-focus); }\n\n.api-category-maker {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px 16px;\n  margin-top: 16px;\n  padding: 16px;\n  border: 1px solid var(--kf-line);\n  border-radius: 14px;\n  background: var(--kf-panel-2);\n}\n\n.api-category-maker .helper,\n.api-category-maker .editor-actions,\n.api-category-maker [role=\"status\"] {\n  grid-column: 1 / -1;\n}\n\n.api-category-maker .helper {\n  margin: 0;\n  color: var(--kf-muted);\n  font-size: 10px;\n  line-height: 1.6;\n}\n\n.api-category-maker label {\n  display: grid;\n  gap: 7px;\n  min-width: 0;\n  color: var(--kf-muted);\n  font-size: 10px;\n  font-weight: 700;\n}\n\n.api-category-maker input,\n.api-category-maker textarea {\n  box-sizing: border-box;\n  width: 100%;\n  min-width: 0;\n}\n\n.api-category-maker textarea {\n  min-height: 74px;\n  resize: vertical;\n}\n\n.api-category-maker .editor-actions {\n  position: static;\n  justify-content: flex-end;\n  margin: 0;\n  padding: 4px 0 0;\n  border-top: 0;\n  background: transparent;\n}\n\n.api-category-maker [role=\"status\"] {\n  margin: 0;\n  color: var(--kf-muted);\n  font-size: 10px;\n}\n\n.imposter-stage {\n  max-width: 760px;\n  padding-bottom: 24px;\n}\n\n.imposter-stage > .eyebrow {\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 55%);\n  background: color-mix(in srgb, var(--kf-accent), var(--kf-panel) 92%);\n  color: var(--kf-accent);\n  font: 800 9px ui-monospace, monospace;\n  letter-spacing: .12em;\n}\n\n.imposter-stage .page-title {\n  margin: 22px auto 8px;\n  max-width: 620px;\n  line-height: .96;\n  letter-spacing: -.075em;\n}\n\n.imposter-stage .page-title em {\n  color: var(--kf-accent);\n  font-style: normal;\n}\n\n.imposter-stage .reveal-instruction {\n  margin-bottom: 24px;\n  color: var(--kf-muted);\n}\n\n.imposter-stage .role-card {\n  width: min(390px, 88vw);\n  aspect-ratio: 1.42;\n  margin: 0 auto 13px;\n  filter: drop-shadow(0 24px 34px rgb(0 0 0 / 22%));\n}\n\n.imposter-stage .role-card-face {\n  border-color: color-mix(in srgb, var(--kf-accent), #ffffff 20%);\n  border-radius: 24px;\n  background:\n    radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--kf-accent), transparent 78%), transparent 48%),\n    linear-gradient(145deg, color-mix(in srgb, var(--kf-panel-2), #ffffff 5%), var(--kf-panel));\n  box-shadow: inset 0 1px rgb(255 255 255 / 10%), 0 18px 38px rgb(0 0 0 / 24%);\n}\n\n.imposter-stage .role-card-face:before {\n  inset: 9px;\n  border-color: color-mix(in srgb, var(--kf-accent), transparent 72%);\n}\n\n.imposter-stage .role-card-mark {\n  width: 58px;\n  height: 58px;\n  border-radius: 18px;\n  box-shadow: 0 0 0 7px color-mix(in srgb, var(--kf-accent), transparent 91%), 0 10px 24px color-mix(in srgb, var(--kf-accent), transparent 82%);\n}\n\n.imposter-stage .role-card-back-title {\n  font-size: clamp(21px, 5vw, 26px);\n  letter-spacing: .12em;\n}\n\n.imposter-stage .role-accessible-toggle {\n  margin: 0 auto 15px;\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 60%);\n  background: color-mix(in srgb, var(--kf-accent), var(--kf-panel) 94%);\n  color: var(--kf-muted);\n}\n\n.imposter-stage .reveal-handoff-hint {\n  width: min(520px, 100%);\n  margin: 0 auto 16px;\n  padding: 11px 16px;\n  border: 1px solid var(--kf-line);\n  border-radius: 12px;\n  background: color-mix(in srgb, var(--kf-panel), transparent 8%);\n  color: var(--kf-muted);\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.imposter-stage .reveal-handoff-hint.is-ready {\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 55%);\n  color: var(--kf-text);\n}\n\n.imposter-stage .pass-button {\n  min-width: min(300px, 100%);\n  min-height: 48px;\n  border-radius: 14px;\n  font-size: 11px;\n  box-shadow: 0 10px 24px color-mix(in srgb, var(--kf-accent), transparent 78%);\n}\n\n@media (max-width: 620px) {\n  .api-category-maker { grid-template-columns: 1fr; }\n  .imposter-stage { margin-top: 20px; padding-inline: 8px; }\n  .imposter-stage .page-title { font-size: clamp(39px, 11vw, 54px); }\n  .imposter-stage .reveal-instruction { margin-bottom: 18px; font-size: 11px; }\n  .imposter-stage .role-card { width: min(350px, 88vw); }\n  .imposter-stage .pass-button { width: min(300px, 92vw); }\n}\n\n.resume-banner-v2 {\n  border-color: color-mix(in srgb, var(--kf-accent), transparent 54%);\n  border-radius: 15px;\n  background: linear-gradient(110deg, color-mix(in srgb, #263b25, var(--kf-panel) 16%), color-mix(in srgb, #172820, var(--kf-panel) 18%));\n  box-shadow: 0 14px 34px rgb(0 0 0 / 18%), inset 0 1px rgb(255 255 255 / 5%);\n  transition: transform var(--kf-motion-standard), box-shadow var(--kf-motion-standard), border-color var(--kf-motion-standard);\n}\n\n.resume-banner-v2:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgb(0 0 0 / 22%); }\n.app.light .resume-banner-v2 {\n  border-color: #b8cf9e;\n  background: linear-gradient(110deg, #f0f7e8, #e8f1e4);\n  color: #1b3020;\n  box-shadow: 0 12px 30px rgb(42 67 38 / 9%), inset 0 1px #ffffff;\n}\n.app.light .resume-icon { border-color: #c4d8ae; background: #e2efd4; color: #4e741f; }\n.app.light .resume-copy small,\n.app.light .resume-arrow { color: #4e741f; }\n.app.light .resume-copy b { color: #203425; }\n.app.light .resume-copy > span { color: #5f725c; }\n\n.game-card-v2 {\n  position: relative;\n  border-color: color-mix(in srgb, var(--accent), var(--kf-line) 72%);\n  border-radius: 18px;\n  background: linear-gradient(152deg, color-mix(in srgb, var(--accent), #121a25 91%), rgb(13 19 28 / 96%) 76%);\n  box-shadow: 0 10px 28px rgb(0 0 0 / 18%), inset 0 1px rgb(255 255 255 / 4%);\n  transition: translate var(--kf-motion-standard) var(--kf-ease), border-color var(--kf-motion-standard), box-shadow var(--kf-motion-standard);\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  min-height: 248px;\n  padding: 18px;\n  text-align: left;\n}\n\n.game-card-v2:hover {\n  translate: 0 -4px;\n  border-color: color-mix(in srgb, var(--accent), transparent 38%);\n  box-shadow: 0 20px 42px rgb(0 0 0 / 24%), 0 0 32px color-mix(in srgb, var(--accent), transparent 88%), inset 0 1px rgb(255 255 255 / 7%);\n}\n\n.game-card-v2:focus-visible { outline: none; box-shadow: var(--kf-focus), 0 16px 38px rgb(0 0 0 / 20%); }\n\n.game-card-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.game-card-v2 .card-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 12px;\n  color: var(--accent);\n  border: 1px solid color-mix(in srgb, var(--accent), transparent 65%);\n  background: color-mix(in srgb, var(--accent), transparent 92%);\n  box-shadow: 0 4px 14px color-mix(in srgb, var(--accent), transparent 85%);\n  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.22s, box-shadow 0.22s;\n  flex: none;\n}\n\n.game-card-v2:hover .card-icon {\n  transform: scale(1.06);\n  border-color: color-mix(in srgb, var(--accent), transparent 35%);\n  box-shadow: 0 6px 20px color-mix(in srgb, var(--accent), transparent 70%);\n}\n\n.game-card-top-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.game-card-index {\n  color: color-mix(in srgb, var(--accent), var(--kf-subtle) 35%);\n  font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;\n  letter-spacing: 0.08em;\n  padding: 3px 7px;\n  border-radius: 99px;\n  background: rgb(255 255 255 / 4%);\n  border: 1px solid rgb(255 255 255 / 8%);\n  line-height: 1;\n}\n\n.game-card-v2 .card-arrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  flex: none;\n  border-radius: 10px;\n  background: rgb(255 255 255 / 4%);\n  border: 1px solid rgb(255 255 255 / 8%);\n  color: var(--kf-subtle);\n  transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;\n}\n\n.game-card-v2:hover .card-arrow {\n  background: color-mix(in srgb, var(--accent), transparent 85%);\n  border-color: color-mix(in srgb, var(--accent), transparent 50%);\n  color: var(--accent);\n  transform: translate(2px, -2px);\n}\n\n.game-card-bottom {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 3px;\n  width: 100%;\n  margin: 12px 0 8px;\n}\n\n.game-card-category {\n  color: var(--accent);\n  font: 800 8.5px ui-monospace, SFMono-Regular, Menlo, monospace;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.game-card-bottom h3 {\n  margin: 2px 0 4px;\n  color: #f6f8fc;\n  font-size: 21px;\n  font-weight: 850;\n  letter-spacing: -0.045em;\n  line-height: 1.15;\n}\n\n.game-card-bottom p {\n  margin: 0;\n  color: #aab6c4;\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.game-card-meta {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: auto;\n  padding-top: 13px;\n  border-top: 1px solid rgb(255 255 255 / 8%);\n  color: #91a0ae;\n  font: 700 9px ui-monospace, monospace;\n  letter-spacing: 0.07em;\n}\n\n.game-card-meta span {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.game-card-meta span:last-child {\n  color: var(--accent);\n  font-weight: 800;\n}\n\n.game-card-meta span:last-child svg {\n  transition: transform 0.2s;\n}\n\n.game-card-v2:hover .game-card-meta span:last-child svg {\n  transform: translateX(3px);\n}\n\n.app.light .game-card-v2 {\n  border-color: color-mix(in srgb, var(--accent), #dce4ed 58%);\n  background: linear-gradient(150deg, color-mix(in srgb, var(--accent), #ffffff 95%), rgb(255 255 255 / 96%) 75%);\n  color: #182334;\n  box-shadow: 0 8px 24px rgb(38 55 75 / 7%), inset 0 1px #ffffff;\n}\n\n.app.light .game-card-v2:hover {\n  border-color: color-mix(in srgb, var(--accent), #dce4ed 20%);\n  box-shadow: 0 18px 34px rgb(38 55 75 / 12%), inset 0 1px #ffffff;\n}\n\n.app.light .game-card-v2 .card-icon {\n  border-color: color-mix(in srgb, var(--accent), #b4c7dc 40%);\n  background: color-mix(in srgb, var(--accent), #ffffff 88%);\n  color: color-mix(in srgb, var(--accent), #152538 35%);\n  box-shadow: 0 3px 10px rgb(38 55 75 / 8%);\n}\n\n.app.light .game-card-index {\n  background: rgb(22 37 55 / 5%);\n  border-color: rgb(22 37 55 / 10%);\n  color: #4b6077;\n}\n\n.app.light .game-card-v2 .card-arrow {\n  background: rgb(22 37 55 / 5%);\n  border-color: rgb(22 37 55 / 10%);\n  color: #4b6077;\n}\n\n.app.light .game-card-v2:hover .card-arrow {\n  background: color-mix(in srgb, var(--accent), transparent 82%);\n  border-color: color-mix(in srgb, var(--accent), transparent 45%);\n  color: color-mix(in srgb, var(--accent), #152538 35%);\n}\n\n.app.light .game-card-bottom h3 { color: #172538; }\n.app.light .game-card-bottom p { color: #536579; }\n.app.light .game-card-meta { border-color: rgb(31 47 67 / 12%); color: #5d6d7e; }\n.app.light .game-card-meta span:last-child { color: color-mix(in srgb, var(--accent), #26384b 26%); }\n\n.home-promise {\n  border-color: var(--kf-line);\n  border-radius: 18px;\n  background: linear-gradient(145deg, color-mix(in srgb, var(--kf-panel), transparent 2%), color-mix(in srgb, var(--kf-panel-2), transparent 10%));\n  box-shadow: 0 18px 46px rgb(0 0 0 / 8%);\n}\n.app.light .home-promise { box-shadow: 0 18px 46px rgb(38 55 75 / 6%); }\n\n.setup-config-card,\n.player-panel,\n.setting-card,\n.history-summary-card,\n.history-row-v2,\n.setup-aside {\n  border-color: var(--kf-line);\n  border-radius: 16px;\n  box-shadow: 0 12px 34px rgb(0 0 0 / 9%), inset 0 1px rgb(255 255 255 / 2%);\n}\n.app.light .setup-config-card,\n.app.light .player-panel,\n.app.light .setting-card,\n.app.light .history-summary-card,\n.app.light .history-row-v2,\n.app.light .setup-aside {\n  box-shadow: 0 12px 34px rgb(38 55 75 / 6%), inset 0 1px #ffffff;\n}\n\n.setting-card {\n  gap: 14px;\n  padding: clamp(18px, 2.1vw, 25px);\n  background: color-mix(in srgb, var(--kf-panel), transparent 2%);\n}\n.setting-card h2 { letter-spacing: -.035em; }\n.setting-card input,\n.setting-card select,\n.setting-card textarea,\n.setting-select {\n  border-color: var(--kf-line);\n  border-radius: 10px;\n  background: var(--kf-panel-2);\n}\n.setting-card input:focus-visible,\n.setting-card select:focus-visible,\n.setting-card textarea:focus-visible {\n  outline: none;\n  border-color: var(--kf-accent);\n  box-shadow: var(--kf-focus);\n}\n\n.kf-switch-row {\n  padding: 14px 0;\n  border-color: color-mix(in srgb, var(--kf-line), transparent 18%);\n}\n.kf-switch-label { font-size: 13px; letter-spacing: -.01em; }\n.kf-switch-description { max-width: 48ch; line-height: 1.55; }\n.kf-switch {\n  min-height: 40px;\n  padding: 4px 9px;\n  border-radius: 12px;\n  background: color-mix(in srgb, var(--kf-panel-2), transparent 2%);\n  transition: border-color var(--kf-motion-standard), background var(--kf-motion-standard), color var(--kf-motion-standard), box-shadow var(--kf-motion-standard);\n}\n.kf-switch-track {\n  width: 46px;\n  height: 27px;\n  padding: 3px;\n  border: 1px solid color-mix(in srgb, var(--kf-line), transparent 15%);\n  background: #526071;\n  transition: background var(--kf-motion-standard), border-color var(--kf-motion-standard), box-shadow var(--kf-motion-standard);\n}\n.kf-switch-thumb {\n  width: 19px;\n  height: 19px;\n  background: #ffffff;\n  box-shadow: 0 2px 6px rgb(0 0 0 / 22%), inset 0 1px rgb(255 255 255 / 72%);\n  transition: transform var(--kf-motion-standard) var(--kf-ease), width var(--kf-motion-fast);\n}\n.kf-switch.is-on {\n  border-color: color-mix(in srgb, var(--kf-accent), var(--kf-line) 42%);\n  background: color-mix(in srgb, var(--kf-accent), var(--kf-panel) 93%);\n}\n.kf-switch.is-on .kf-switch-track {\n  border-color: color-mix(in srgb, var(--kf-accent), transparent 10%);\n  background: var(--kf-accent);\n  box-shadow: inset 0 1px rgb(255 255 255 / 24%), 0 0 0 3px color-mix(in srgb, var(--kf-accent), transparent 91%);\n}\n.kf-switch.is-on .kf-switch-thumb { transform: translateX(19px); }\n.kf-switch:focus-visible { outline: none; box-shadow: var(--kf-focus); }\n.kf-switch:active .kf-switch-thumb { width: 21px; }\n\n.app-footer {\n  border-color: color-mix(in srgb, var(--kf-line), transparent 10%);\n}\n\n@media (hover: hover) and (pointer: fine) {\n  .primary-nav-link:hover svg,\n  .command-trigger:hover svg { transform: translateY(-1px); }\n  .primary-nav-link svg,\n  .command-trigger svg { transition: transform var(--kf-motion-fast); }\n}\n\n@media (max-width: 620px) {\n  .ambient-toggle,\n  .theme-toggle { width: 36px; min-width: 36px; height: 36px; min-height: 36px; border-radius: 11px; }\n  .theme-toggle-track { width: 30px; height: 30px; }\n  .theme-toggle-track::before { top: 2px; left: 2px; width: 24px; height: 24px; }\n  .theme-toggle-track svg { top: 50%; left: 50%; }\n  .app.light .theme-toggle-track svg { left: 50%; }\n  .app.light .theme-toggle-track::before { transform: scale(.92); }\n  .hero-v2 { background-position: center; }\n  .game-card-v2 { min-height: 280px; }\n  .setting-card { padding: 17px; }\n}\n\n@media (max-width: 390px) {\n  .ambient-toggle,\n  .theme-toggle { width: 32px; min-width: 32px; height: 34px; min-height: 34px; padding: 0; }\n  .theme-toggle-track { width: 28px; height: 28px; }\n  .theme-toggle-track::before { width: 21px; height: 21px; }\n  .theme-toggle-track svg { top: 50%; left: 50%; width: 14px; height: 14px; }\n  .app.light .theme-toggle-track svg { left: 50%; }\n  .app.light .theme-toggle-track::before { transform: scale(.92); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .game-card-v2,\n  .resume-banner-v2,\n  .brand-logo-wrap,\n  .theme-toggle,\n  .ambient-toggle,\n  .kf-switch,\n  .kf-switch-thumb,\n  .kf-switch-track { transition: none !important; }\n  .game-card-v2:hover,\n  .resume-banner-v2:hover { translate: none; transform: none; }\n}\n\n:root[data-motion=\"reduce\"] .ambient-scene { opacity: .16; }\n\n@media (max-width: 390px) {\n  .topbar { padding-inline: 12px; }\n  .topbar-inner { gap: 4px; }\n  .brand { gap: 5px; }\n  .brand-logo-wrap { width: 30px; height: 30px; border-radius: 9px; }\n  .brand-logo { width: 22px; height: 22px; }\n  .brand-name { font-size: 11px; letter-spacing: .06em; }\n  .primary-nav { gap: 0; padding: 2px; }\n  .primary-nav-link { width: 30px; min-height: 32px; padding: 0; }\n  .topbar-actions { gap: 3px; }\n  .command-trigger { width: 32px; min-width: 32px; min-height: 32px; height: 32px; padding: 0; }\n  .ambient-toggle,\n  .theme-toggle { width: 30px; min-width: 30px; height: 32px; min-height: 32px; }\n  .theme-toggle-track { width: 25px; height: 25px; }\n  .theme-toggle-track::before { top: 2px; left: 2px; width: 19px; height: 19px; }\n  .theme-toggle-track svg { top: 50%; left: 50%; width: 13px; height: 13px; }\n  .app.light .theme-toggle-track svg { left: 50%; }\n}\n\n@media (max-width: 340px) {\n  .brand-name { font-size: 10px; }\n  .brand-logo-wrap { width: 28px; height: 28px; }\n  .brand-logo { width: 20px; height: 20px; }\n}\n\n/* Deliberately unadvertised creator-only unlock surface. */\ndialog.creator-unlock-panel{position:fixed;inset:0;margin:auto;width:min(390px,calc(100% - 40px));max-height:min(85vh,760px);overflow:auto;padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--panel);color:var(--text);box-shadow:0 24px 90px rgba(0,0,0,.45)}\ndialog.creator-unlock-panel::backdrop{background:rgba(3,7,12,.78);backdrop-filter:blur(12px)}\n.creator-unlock-panel h2{margin:8px 0 18px;font-size:25px;letter-spacing:-.04em}\n.creator-unlock-panel p{color:var(--muted);font-size:12px;line-height:1.6}\n.creator-unlock-panel form{display:grid;gap:12px}\n.creator-unlock-panel label{font-size:11px;font-weight:800;color:var(--muted)}\n.creator-unlock-panel input{width:100%;min-height:44px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--panel2);color:var(--text)}\n.creator-unlock-panel .primary{width:100%;margin-top:4px}\n.creator-unlock-close{position:absolute;top:12px;right:12px;width:34px;height:34px;border:1px solid var(--line);border-radius:9px;background:var(--panel2);color:var(--text);font-size:22px}\n.creator-queue{display:grid;gap:10px;margin:18px 0;max-height:45vh;overflow:auto}\n.creator-queue>strong{font-size:10px;letter-spacing:.1em;color:var(--muted)}\n.creator-queue>small{font-size:11px;color:var(--muted)}\n.creator-queue article{padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}\n.creator-queue article p{margin:0 0 6px;color:var(--text);font-size:12px}\n.creator-queue article small{font-size:10px;color:var(--muted)}\n.creator-queue article div{display:flex;gap:7px;margin-top:10px}\n.creator-queue article button{padding:6px 9px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--text);font-size:10px;font-weight:750}\n"]],[[2,36]],["BODY",{},[[2,37]],["DIV",{"id":"root"},["DIV",{"class":"app dark","tabindex":"-1"},["CANVAS",{"__playwright_bounding_rect__":"{\"left\":0,\"top\":0,\"right\":1280,\"bottom\":720}","class":"ambient-scene","aria-hidden":"true","data-ambient-scene":"true","data-paused":"false","data-interaction-count":"0","width":"1280","height":"720","style":"width: 1280px; height: 720px;"}],["A",{"class":"skip-link","href":"#main-content"},"Skip to content"],["HEADER",{"class":"topbar"},["DIV",{"class":"topbar-inner"},["BUTTON",{"type":"button","class":"brand","aria-labelledby":"king-fun-brand-name"},["SPAN",{"class":"brand-logo-wrap"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:4173/king-fun-logo.svg","class":"brand-logo","width":"34","height":"34","alt":"","aria-hidden":"true","decoding":"async","src":"/king-fun-logo.svg"}]],["SPAN",