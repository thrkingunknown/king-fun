{"type":"frame-snapshot","snapshot":{"callId":"ctnp@47","phase":"action","pageId":"page@4857dc3b3ac38c6c8e591f725623b8d5","frameId":"frame@bf9f49873cd98f642318cb5317ff7278","frameUrl":"http://127.0.0.1:4173/","doctype":"html","html":["HTML",{"__playwright_scroll_top_":"1385","lang":"en","data-theme":"dark","data-motion":"system"},["HEAD",{},[[2,0]],[[2,1]],[[2,2]],[[2,3]],[[2,4]],[[2,5]],[[2,6]],[[2,7]],[[2,8]],[[2,9]],[[2,10]],[[2,11]],[[2,12]],[[2,13]],[[2,14]],[[2,15]],[[2,16]],[[2,17]],[[2,18]],[[2,19]],[[2,20]],[[2,21]],[[2,22]],[[2,23]],[[2,24]],[[2,25]],[[2,26]],[[2,27]],[[2,28]],[[2,29]],["TITLE",{},"Home — KING-FUN"],[[2,32]],[[2,34]],["STYLE",{},".chaos-art {\n  --art-size: min(100%, 440px);\n  width: var(--art-size);\n  aspect-ratio: 1;\n  position: relative;\n  justify-self: center;\n  isolation: isolate;\n  overflow: visible;\n  contain: layout paint;\n}\n.chaos-orbit {\n  position: absolute;\n  inset: 12%;\n  border: 1px solid #aeb5c52a;\n  border-radius: 50%;\n  animation: chaos-orbit 28s linear infinite;\n}\n.chaos-orbit-a::before, .chaos-orbit-b::before {\n  content: ''; position: absolute; width: 8px; height: 8px; top: 12%; left: 12%;\n  border-radius: 50%; background: #d6f59b; box-shadow: 0 0 18px #d6f59b;\n}\n.chaos-orbit-b { inset: 23%; border-style: dashed; animation-duration: 19s; animation-direction: reverse; }\n.chaos-orbit-b::before { width: 5px; height: 5px; background: #c1a8ff; box-shadow: 0 0 14px #c1a8ff; }\n.chaos-core-wrap { position: absolute; inset: 0; display: grid; place-items: center; }\n.chaos-core {\n  position: relative; width: 27%; aspect-ratio: 1; z-index: 2;\n  border: 1px solid #e4ffc08a; border-radius: 25%; transform: rotate(45deg);\n  background: linear-gradient(145deg, #dfffaa, #9dcc63 70%, #729c43);\n  box-shadow: 0 0 0 12px #d6f59b0b, 0 0 0 28px #d6f59b08, 0 18px 45px #0008, 0 0 60px #d6f59b42;\n  animation: chaos-float 4.8s ease-in-out infinite;\n}\n.die-dot { position: absolute; width: 13%; aspect-ratio: 1; border-radius: 50%; background: #25311b; box-shadow: inset 0 1px 2px #0008; }\n.die-dot-a { top: 20%; left: 20%; }.die-dot-b { top: 20%; right: 20%; }.die-dot-c { top: 43%; left: 43%; }.die-dot-d { bottom: 20%; left: 20%; }.die-dot-e { bottom: 20%; right: 20%; }\n.chaos-core-glow { position: absolute; width: 45%; aspect-ratio: 1; border-radius: 50%; background: #d6f59b18; filter: blur(25px); animation: chaos-pulse 3.5s ease-in-out infinite; }\n.chaos-token {\n  position: absolute; width: 22%; aspect-ratio: .88; z-index: 3; display: flex; flex-direction: column;\n  align-items: center; justify-content: center; gap: 3px; border: 1px solid currentColor;\n  border-radius: 18px; background: color-mix(in srgb, var(--token-bg), #15171c 25%);\n  box-shadow: 0 14px 32px #0005, inset 0 1px #ffffff18; color: var(--token);\n  animation: chaos-float 5s ease-in-out infinite;\n}\n.chaos-token span { font: 700 clamp(22px, 3vw, 34px)/1 'Space Grotesk', sans-serif; }\n.chaos-token small { color: #fff !important; opacity: 1 !important; font: 700 8px 'DM Mono', monospace; letter-spacing: 1.5px; text-shadow: 0 1px 2px #0008; }\n.chaos-token-violet { --token: #c1a8ff; --token-bg: #39304f; top: 12%; left: 12%; rotate: -12deg; animation-delay: -.7s; }\n.chaos-token-orange { --token: #ffc08c; --token-bg: #483427; top: 12%; right: 12%; rotate: 10deg; animation-delay: -2s; }\n.chaos-token-pink { --token: #ffa1bf; --token-bg: #482d3a; bottom: 12%; left: 12%; rotate: 9deg; animation-delay: -3.1s; }\n.chaos-token-mint { --token: #9ce6c9; --token-bg: #263e38; bottom: 12%; right: 12%; rotate: -10deg; animation-delay: -1.4s; }\n.chaos-spark { position: absolute; z-index: 4; color: #d6f59b; font-size: 25px; animation: chaos-twinkle 2.8s ease-in-out infinite; }\n.chaos-spark-a { top: 26%; right: 5%; }.chaos-spark-b { bottom: 22%; left: 5%; color: #c1a8ff; animation-delay: -1.4s; }\n.chaos-caption { position: absolute; left: 50%; bottom: -3%; transform: translateX(-50%); white-space: nowrap; color: #9b9da5; font: 8px 'DM Mono', monospace; letter-spacing: 1.8px; }\n.chaos-caption i { display: inline-block; width: 6px; height: 6px; margin: 0 8px 1px 0; border-radius: 50%; background: #d6f59b; box-shadow: 0 0 12px #d6f59b; }\n@keyframes chaos-orbit { to { transform: rotate(360deg); } }\n@keyframes chaos-float { 0%,100% { translate: 0 0; } 50% { translate: 0 -10px; } }\n@keyframes chaos-pulse { 0%,100% { scale: .88; opacity: .45; } 50% { scale: 1.12; opacity: .9; } }\n@keyframes chaos-twinkle { 0%,100% { opacity: .45; transform: scale(.8) rotate(0); } 50% { opacity: 1; transform: scale(1.2) rotate(35deg); } }\n@media (max-width: 900px) { .chaos-art { --art-size: min(100%, 350px); } }\n@media (max-width: 620px) {\n  .chaos-art { --art-size: min(82vw, 300px); margin: 4px auto 14px; }\n  .chaos-token { border-radius: 13px; }\n  .chaos-token small { font-size: 7px; color: #fff !important; opacity: 1 !important; }\n  .chaos-caption { bottom: -5%; font-size: 7px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .chaos-orbit, .chaos-core, .chaos-core-glow, .chaos-token, .chaos-spark { animation: none !important; }\n}\n"],["STYLE",{},"/* Game-stage visual language. Application shell, responsive grid and shared\n   component styling live in design-system.css. */\n.play-screen{--accent:#b9a5ff;--accent-dark:#252238;min-height:calc(100svh - 140px);padding:clamp(22px,4vw,42px) clamp(14px,4vw,64px) max(72px,env(safe-area-inset-bottom));background:radial-gradient(ellipse at 50% 35%,color-mix(in srgb,var(--accent-dark),transparent 25%),var(--bg) 70%)}\n.play-screen.violet{--accent:#b9a5ff;--accent-dark:#262238}.play-screen.orange{--accent:#ffb77e;--accent-dark:#30251e}.play-screen.pink{--accent:#f39bb8;--accent-dark:#30212a}.play-screen.mint{--accent:#86d9bd;--accent-dark:#1d302d}\n.play-head{display:flex;align-items:center;justify-content:space-between;gap:14px;max-width:1280px;margin:auto}.play-head .back-link{margin:0}.autosave{display:inline-flex;align-items:center;gap:7px;color:#91c98d;font:700 9px ui-monospace,monospace;letter-spacing:.1em}.game-stage{width:min(820px,100%);margin:clamp(26px,5vw,58px) auto 0;text-align:center}.game-stage .page-title{font-size:clamp(39px,6vw,68px)}.game-stage>.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid var(--line);border-radius:99px;background:var(--panel);color:var(--muted)}.game-stage .lead{margin-inline:auto}.secret-card,.prompt-card{width:min(600px,100%);margin:24px auto;padding:clamp(18px,3vw,30px);border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,var(--panel),var(--panel2));box-shadow:var(--kf-shadow)}.secret-card h2{margin:17px 0;color:var(--accent);font-size:clamp(26px,4vw,38px);font-weight:900;letter-spacing:-.05em}.secret-card p{color:var(--muted);font-size:12px;line-height:1.7}.secret-card .primary{margin-top:10px}.primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 17px;border:1px solid transparent;border-radius:12px;background:var(--kf-accent);color:var(--kf-accent-ink);font-size:12px;font-weight:850;box-shadow:0 7px 22px color-mix(in srgb,var(--kf-accent),transparent 83%);transition:transform .16s,filter .16s}.primary:hover{filter:brightness(1.08);transform:translateY(-1px)}.primary:active{transform:scale(.985)}.primary:disabled{opacity:.45;box-shadow:none}.secondary-action,.text-button,.small-text-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:0 10px;border:1px solid var(--line);border-radius:10px;background:var(--panel2);color:var(--muted);font-size:10px;font-weight:750}.text-button,.small-text-button{border-color:transparent;background:transparent;text-decoration:underline;text-underline-offset:3px}.text-button:hover,.small-text-button:hover{color:var(--text)}.reveal-instruction{margin:0 auto 22px;color:var(--muted);font-size:12px;line-height:1.6}.pass-button{min-width:210px}.timer-pill,.discussion-clock{display:inline-flex;align-items:center;justify-content:center;min-width:72px;min-height:36px;padding:0 12px;border:1px solid var(--line);border-radius:99px;background:var(--panel);color:var(--text);font:800 12px ui-monospace,monospace}.score-row{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin:16px auto}.score-row>span,.score-row>div{display:grid;gap:4px;min-width:95px;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}.score-row b{color:var(--accent);font-size:24px}.score-row strong{color:var(--text);font-size:10px}.guess-word{display:grid;place-items:center;min-height:180px;margin:18px auto;padding:clamp(18px,4vw,24px);border:1px solid color-mix(in srgb,var(--accent),var(--line) 55%);border-radius:22px;background:radial-gradient(circle at 50% 20%,color-mix(in srgb,var(--accent),transparent 88%),transparent 65%),var(--panel);color:var(--text);font-size:clamp(28px,7vw,56px);font-weight:900;line-height:1.08;letter-spacing:-.05em;text-align:center;text-wrap:balance;overflow-wrap:anywhere;word-break:break-word;box-shadow:var(--kf-shadow)}.guess-controls,.choice-buttons,.never-actions,.never-response-controls{display:flex;justify-content:center;flex-wrap:wrap;gap:9px;margin:16px auto}.guess-controls button,.choice-buttons button,.never-actions button,.never-response-controls button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 15px;border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);font-size:11px;font-weight:800}.guess-controls .correct-btn,.never-response-controls .response-yes,.group-response-actions .response-yes{border-color:color-mix(in srgb,var(--accent),transparent 50%);background:color-mix(in srgb,var(--accent),var(--panel) 88%);color:var(--text)}.never-response-controls .response-no,.group-response-actions .response-no{border-color:#e58a9344;background:#e58a9314;color:var(--text)}.guess-controls button:hover,.choice-buttons butto