{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KING-FUN",
  "version": "1.0.0",
  "identifier": "com.kingfun.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run --filter @king-fun/frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KING-FUN",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.vercel.app http://localhost:* http://127.0.0.1:* http://[::1]:*; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "KING-FUN party game app",
    "longDescription": "KING-FUN is a party game collection for local and social play.",
    "publisher": "KING-FUN",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
