# KING-FUN environment template (no secrets). Copy to `.env` locally if needed.
# AI is optional and disabled by default; bundled/local content works without it.
AI_ENABLED=false
AI_MAX_REQUESTS_PER_MINUTE=20
AI_UPSTASH_PREFIX=king-fun:ai
AI_PROVIDER_TIMEOUT_MS=45000

# Provider model defaults (provider API keys remain BYOK in the browser)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI gateway (server-side operator credentials only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b

# Upstash Redis rate limiter (server-side)
AI_LIMITER_REST_URL=
AI_LIMITER_REST_TOKEN=

# Community content vault / moderation (server-side)
CONTENT_VAULT_REST_URL=
CONTENT_VAULT_REST_TOKEN=

# Creator unlock (server-side secret; never expose to frontend)
KING_FUN_CREATOR_SECRET=
KING_FUN_CREATOR_TOKEN_SECRET=

# Frontend (Vite) — public values only
# Web/PWA same-origin default is "/api". For Tauri production builds, set the
# full hosted API base including /api (the app appends /v1/...):
VITE_KING_FUN_API_URL=https://YOUR_PROJECT.vercel.app/api
